AUTH_JWT_SECRET=replace-with-long-random-secret
AUTH_STORAGE_DRIVER=postgres
CONTENT_STORAGE_DRIVER=postgres
VERIFICATION_STORAGE_DRIVER=postgres
COMMUNITY_STORAGE_DRIVER=postgres
SEARCH_STORAGE_DRIVER=postgres
AI_SUMMARY_DRIVER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AI_SUMMARY_TIMEOUT_MS=15000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/okkhor
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=10000
DB_POOL_CONNECTION_TIMEOUT_MS=5000
DB_POOL_MAX_USES=7500
EPHEMERAL_STORAGE_DRIVER=auto
REDIS_URL=redis://localhost:6379
