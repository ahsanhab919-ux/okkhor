{
  "name": "okkhor",
  "version": "0.1.0",
  "private": true,
  "description": "Journal Club Asia / Okkhor production-ready repository scaffold",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --coverage",
    "db:migrate:create": "node-pg-migrate create --config-file node-pg-migrate.config.cjs --migration-file-language cjs",
    "db:migrate": "node-pg-migrate up --config-file node-pg-migrate.config.cjs --envPath .env.local",
    "db:migrate:down": "node-pg-migrate down --config-file node-pg-migrate.config.cjs --envPath .env.local",
    "db:migrate:redo": "node-pg-migrate redo --config-file node-pg-migrate.config.cjs --envPath .env.local",
    "db:verify:postgres": "node --env-file=.env.local --import tsx ./scripts/verify-postgres-auth.ts",
    "ci": "npm run lint && npm run typecheck && npm run test:ci && npm run build"
  },
  "dependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.20.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.3",
    "jsonwebtoken": "^9.0.3",
    "next": "^15.0.0",
    "pg": "^8.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitest/coverage-v8": "^3.0.5",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.0.0",
    "jsdom": "^25.0.1",
    "node-pg-migrate": "^9.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  },
  "overrides": {
    "postcss": "^8.5.34",
    "brace-expansion": "^5.1.0",
    "tinypool": "^2.2.0"
  }
}
